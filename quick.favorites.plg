<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "quick.favorites">
<!ENTITY author "hernandito">
<!ENTITY version "2026.08.27j">
<!ENTITY github "hernandito/quick.favorites">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="/Settings/QuickFavorites"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;"
        min="6.12.0">

<CHANGES>
###2026.08.27j
- Adopted safe template.php injection logic to bypass page rendering blocks.
</CHANGES>

<FILE Name="&plugdir;/QuickFavorites.page">
  <URL>https://raw.githubusercontent.com/&github;/main/QuickFavorites.page</URL>
</FILE>

<FILE Name="&plugdir;/popup.php">
  <URL>https://raw.githubusercontent.com/&github;/main/popup.php</URL>
</FILE>

<FILE Name="&plugdir;/favs.js">
  <URL>https://raw.githubusercontent.com/&github;/main/favs.js</URL>
</FILE>

<FILE Name="&plugdir;/log_api.php">
  <URL>https://raw.githubusercontent.com/&github;/main/log_api.php</URL>
</FILE>

<FILE Name="&plugdir;/&name;.png">
  <URL>https://raw.githubusercontent.com/&github;/main/icon.png</URL>
</FILE>

<!-- GLOBAL FOOTER INCLUSION FILE -->
<FILE Name="&plugdir;/footer.php">
<INLINE>
<![CDATA[
<?php
$qf_conf = "/boot/config/plugins/quick.favorites/appearance.json";
$qf_settings = file_exists($qf_conf) ? json_decode(file_get_contents($qf_conf), true) : [];
$qf_label = isset($qf_settings['header_label']) ? $qf_settings['header_label'] : '⭐⭐';
?>
<script>var qf_settings = { label: "<?= htmlspecialchars($qf_label) ?>" };</script>
<?php include "/usr/local/emhttp/plugins/quick.favorites/popup.php"; ?>
<script src="/plugins/quick.favorites/favs.js"></script>
]]>
</INLINE>
</FILE>

<!-- INSTALL SCRIPT -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="quick.favorites"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"
TEMPLATE="/usr/local/emhttp/plugins/dynamix/template.php"
MARK_START="<!-- QUICK_FAVORITES_INJECT_START -->"
MARK_END="<!-- QUICK_FAVORITES_INJECT_END -->"

# Create config files if they don't exist
if [ ! -d "$CONF" ]; then mkdir -p "$CONF"; fi
if [ ! -f "$CONF/appearance.json" ]; then echo '{"menu_title":"Quick Favorites","icon_size":"32","bg_color":"#1c1c1c","header_color":"#ffca28","header_line":"#333333","section_title_color":"#888888","text_color":"#e0e0e0","grid_columns":"4","menu_width":"480","show_header":"yes","hover_color":"#333333","header_label":"⭐⭐"}' > "$CONF/appearance.json"; fi
if [ ! -f "$CONF/favorites.json" ]; then echo '[{"path":"\/Settings\/QuickFavorites","category":"General","label":"Quick Fav Settings","icon":"fa-star","action":"_self"}]' > "$CONF/favorites.json"; fi
touch "$CONF/custom.css"
touch "$CONF/user_notes.txt"

chown -R root:root "$PLUGDIR"
chmod -R 755 "$PLUGDIR"

# REMOVE EXISTING PATCH IF IT EXISTS
sed -i "/$MARK_START/,/$MARK_END/d" "$TEMPLATE"

# CREATE NEW PATCH
TMPFILE="$(mktemp)"
cat > "$TMPFILE" << 'EOF2'
<!-- QUICK_FAVORITES_INJECT_START -->
<?php if(file_exists("/usr/local/emhttp/plugins/quick.favorites/footer.php")) { include("/usr/local/emhttp/plugins/quick.favorites/footer.php"); } ?>
<!-- QUICK_FAVORITES_INJECT_END -->
EOF2

# INJECT SAFELY BEFORE </body>
if grep -q '</body>' "$TEMPLATE"; then
  sed -i "/<\/body>/e cat '$TMPFILE'" "$TEMPLATE"
else
  cat "$TMPFILE" >> "$TEMPLATE"
fi
rm -f "$TMPFILE"

echo "----------------------------------------------------"
echo " Quick Favorites v&version; has been cleanly installed."
echo "----------------------------------------------------"
]]>
</INLINE>
</FILE>

<!-- REMOVE SCRIPT -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="quick.favorites"
TEMPLATE="/usr/local/emhttp/plugins/dynamix/template.php"
MARK_START="<!-- QUICK_FAVORITES_INJECT_START -->"
MARK_END="<!-- QUICK_FAVORITES_INJECT_END -->"

# CLEAN UP THE TEMPLATE PATCH
sed -i "/$MARK_START/,/$MARK_END/d" "$TEMPLATE"
rm -rf "/usr/local/emhttp/plugins/$NAME"

echo "Quick Favorites has been completely removed."
]]>
</INLINE>
</FILE>
</PLUGIN>