<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "quick.favorites">
<!ENTITY author "hernandito">
<!ENTITY version "2026.08.27h">
<!ENTITY github "hernandito/quick.favorites">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="/Settings/QuickFavorites"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;"
        min="6.12.0">

<CHANGES>
###2026.08.27g
- Reverted to safe, native Unraid Button menu injection.
</CHANGES>

<FILE Name="&plugdir;/QuickFavorites.page">
  <URL>https://raw.githubusercontent.com/&github;/main/QuickFavorites.page</URL>
</FILE>

<FILE Name="&plugdir;/popup.php">
  <URL>https://raw.githubusercontent.com/&github;/main/popup.php</URL>
</FILE>

<FILE Name="&plugdir;/favs.js">
  <URL>https://raw.githubusercontent.com/&github;/main/favs.js</URL>
</FILE>

<FILE Name="&plugdir;/log_api.php">
  <URL>https://raw.githubusercontent.com/&github;/main/log_api.php</URL>
</FILE>

<FILE Name="&plugdir;/icon.png">
  <URL>https://raw.githubusercontent.com/&github;/main/icon.png</URL>
</FILE>

<FILE Name="&plugdir;/README.md">
  <URL>https://raw.githubusercontent.com/&github;/main/description.txt</URL>
</FILE>

<!-- NATIVE BUTTON INJECTION -->
<FILE Name="&plugdir;/QuickFavorites.inject.page">
<INLINE>
<![CDATA[
Menu="Buttons"
Link="nav-user"
---
<?php
$qf_conf = "/boot/config/plugins/quick.favorites/appearance.json";
$qf_settings = file_exists($qf_conf) ? json_decode(file_get_contents($qf_conf), true) : [];
$qf_label = isset($qf_settings['header_label']) ? $qf_settings['header_label'] : '⭐⭐';
?>
<a href="#" id="qf-native-custom-link" title="Quick Favorites" style="padding: 0 10px; display: inline-flex; align-items: center; cursor: pointer; color: inherit; text-decoration: none;">
    <?= htmlspecialchars($qf_label) ?>
</a>
<?php include "/usr/local/emhttp/plugins/quick.favorites/popup.php"; ?>
<script src="/plugins/quick.favorites/favs.js"></script>
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="quick.favorites"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"

if [ ! -d "$CONF" ]; then
  mkdir -p "$CONF"
fi
if [ ! -f "$CONF/appearance.json" ]; then
  echo '{"menu_title":"Quick Favorites","icon_size":"32","bg_color":"#1c1c1c","header_color":"#ffca28","header_line":"#333333","section_title_color":"#888888","text_color":"#e0e0e0","grid_columns":"4","menu_width":"480","show_header":"yes","hover_color":"#333333","header_label":"⭐⭐"}' > "$CONF/appearance.json"
fi
if [ ! -f "$CONF/favorites.json" ]; then
  echo '[{"path":"\/Settings\/QuickFavorites","category":"General","label":"Quick Fav Settings","icon":"fa-star","action":"_self"}]' > "$CONF/favorites.json"
fi
touch "$CONF/custom.css"
touch "$CONF/user_notes.txt"

chown -R root:root "$PLUGDIR"
chmod -R 755 "$PLUGDIR"

echo "----------------------------------------------------"
echo " Quick Favorites v&version; has been cleanly installed."
echo "----------------------------------------------------"
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="quick.favorites"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
rm -rf "$PLUGDIR"
echo "Quick Favorites has been removed."
]]>
</INLINE>
</FILE>
</PLUGIN>