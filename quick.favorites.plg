<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "quick.favorites">
<!ENTITY author "hernandito">
<!ENTITY version "2026.08.27l">
<!ENTITY github "hernandito/quick.favorites">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="/Settings/QuickFavorites"
        pluginURL="&pluginURL;"
        support="https://github.com/&github;"
        min="6.12.0">

<CHANGES>
###2026.08.27l
- Fixed DOM structure: Quick Favorites now wraps in its own dedicated nav-item container.
- Clean green-arrow placement after the Scripts tab with matched native menu bar height.
</CHANGES>

<FILE Name="&plugdir;/QuickFavorites.page">
  <URL>https://raw.githubusercontent.com/&github;/main/QuickFavorites.page</URL>
</FILE>

<FILE Name="&plugdir;/popup.php">
  <URL>https://raw.githubusercontent.com/&github;/main/popup.php</URL>
</FILE>

<FILE Name="&plugdir;/favs.js">
  <URL>https://raw.githubusercontent.com/&github;/main/favs.js</URL>
</FILE>

<FILE Name="&plugdir;/log_api.php">
  <URL>https://raw.githubusercontent.com/&github;/main/log_api.php</URL>
</FILE>

<FILE Name="&plugdir;/&name;.png">
  <URL>https://raw.githubusercontent.com/&github;/main/icon.png</URL>
</FILE>

<FILE Name="&plugdir;/README.md">
  <URL>https://raw.githubusercontent.com/&github;/main/description.txt</URL>
</FILE>

<!-- INSTALL & AUTOMATED TEMPLATE PATCHING SCRIPT -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="quick.favorites"
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"
TEMPLATE="/usr/local/emhttp/plugins/dynamix/template.php"
MARK_START="<!-- QUICK_FAVORITES_INJECT_START -->"
MARK_END="<!-- QUICK_FAVORITES_INJECT_END -->"

# 1. Ensure flash configuration directory and default settings exist safely
if [ ! -d "$CONF" ]; then mkdir -p "$CONF"; fi
if [ ! -f "$CONF/appearance.json" ]; then 
  echo '{"menu_title":"Quick Favorites","header_label":"⭐⭐","icon_size":"42","grid_columns":"5","menu_width":"480","show_header":"no","hover_color":"#333333","bg_color":"#000000","header_color":"#FFCA28","header_line":"#333333","section_title_color":"#FFCA28","section_border_color":"#554000","icon_color":"#FFCA28","label_color":"#CCCCCC"}' > "$CONF/appearance.json"
fi
if [ ! -f "$CONF/favorites.json" ]; then 
  echo '[{"path":"\/Settings\/QuickFavorites","category":"General","label":"Quick Fav Settings","icon":"fa-star","action":"_self"}]' > "$CONF/favorites.json"
fi
touch "$CONF/custom.css"
touch "$CONF/user_notes.txt"

chown -R root:root "$PLUGDIR"
chmod -R 755 "$PLUGDIR"

# 2. Clean any prior injection blocks from template.php
sed -i "/$MARK_START/,/$MARK_END/d" "$TEMPLATE"

# 3. Create the clean injection payload with dedicated nav-item wrapper
TMPFILE="$(mktemp)"
cat > "$TMPFILE" << 'EOF2'
<!-- QUICK_FAVORITES_INJECT_START -->
<?php
$qf_conf = "/boot/config/plugins/quick.favorites/appearance.json";
$qf_settings = file_exists($qf_conf) ? json_decode(file_get_contents($qf_conf), true) : [];
$qf_label = isset($qf_settings['header_label']) ? $qf_settings['header_label'] : '⭐⭐';
?>
<script>
var qf_label_text = "<?= htmlspecialchars($qf_label) ?>";
</script>
<?php
if (file_exists("/usr/local/emhttp/plugins/quick.favorites/popup.php")) {
    include("/usr/local/emhttp/plugins/quick.favorites/popup.php");
}
?>
<script>
(function () {
    function createNewMenu() {
        if (document.getElementById('qf-custom-btn')) return;
        
        var menuBar = document.querySelector('div#menu');
        if (!menuBar) return;

        // Create a dedicated nav-item container matching Unraid's layout architecture
        var navItemDiv = document.createElement('div');
        navItemDiv.className = 'nav-item';

        var btn = document.createElement('a');
        btn.id = 'qf-custom-btn';
        btn.href = '#';
        btn.innerHTML = qf_label_text;
        btn.title = 'Quick Favorites';
        btn.style.cssText = 'height: 100%; display: inline-flex; align-items: center; padding: 0 14px; cursor: pointer; text-decoration: none; color: inherit; font-size: 13px; font-weight: bold;';

        navItemDiv.appendChild(btn);

        // Position precisely as its own container right after the Scripts tab
        var scriptTabLink = menuBar.querySelector('a[href*="Script"]');
        var scriptNavItem = scriptTabLink ? scriptTabLink.closest('.nav-item') : null;

        if (scriptNavItem) {
            scriptNavItem.after(navItemDiv);
        } else {
            menuBar.appendChild(navItemDiv);
        }
    }

    var runs = 0;
    var timer = setInterval(function () {
        createNewMenu();
        runs++;
        if (runs >= 30) clearInterval(timer);
    }, 400);

    var obs = new MutationObserver(function () {
        createNewMenu();
    });

    if (document.body) {
        obs.observe(document.body, { childList: true, subtree: true });
        createNewMenu();
    }
})();

// Fully functional click handler for the popup menu
document.addEventListener('click', function(e) {
    var clickedLink = e.target.closest('#qf-custom-btn');
    var customMenu = document.getElementById('my-custom-fav-menu');

    if (clickedLink) {
        e.preventDefault(); 
        e.stopPropagation();
        
        if (!customMenu) return;

        if (customMenu.style.display === 'block') {
            customMenu.style.display = 'none';
        } else {
            customMenu.style.display = 'block';
            var rect = clickedLink.getBoundingClientRect();
            var menuWidth = customMenu.offsetWidth || 480;
            var btnCenter = rect.left + window.scrollX + (rect.width / 2);
            var calculatedLeft = Math.max(15, Math.min(btnCenter - (menuWidth / 2), window.innerWidth - menuWidth - 15));
            customMenu.style.top = (rect.bottom + window.scrollY + 10) + 'px';
            customMenu.style.left = calculatedLeft + 'px';
        }
    } 
    else if (customMenu && customMenu.style.display === 'block') {
        if (!e.target.closest('#my-custom-fav-menu')) {
            customMenu.style.display = 'none';
        } else {
            var itemTarget = e.target.closest('.qf-item');
            if (itemTarget) {
                var action = itemTarget.getAttribute('data-action');
                var path = itemTarget.getAttribute('data-path').trim();
                var token = (typeof csrf_token !== 'undefined') ? csrf_token : '';
                
                if (action === 'script_modal' || action === 'script_background') {
                    e.preventDefault(); e.stopPropagation();
                    var fullScriptPath = "/boot/config/plugins/user.scripts/scripts/" + path + "/script";
                    
                    $.post('/plugins/user.scripts/exec.php', {
                        script: fullScriptPath,
                        action: 'intermediate',
                        csrf_token: token
                    }, function() {
                        var tmpScriptPath = "/tmp/user.scripts/tmpScripts/" + path + "/script";
                        var targetUrl = (action === 'script_modal') 
                            ? "/plugins/user.scripts/startScript.sh&arg1=" + tmpScriptPath 
                            : "/plugins/user.scripts/backgroundScript.sh&arg1=" + tmpScriptPath;
                        
                        openBox(targetUrl, 'Executing: ' + path, 600, 900, true);
                        customMenu.style.display = 'none'; 
                    });
                } 
                else if (action === 'script_log') {
                    e.preventDefault(); e.stopPropagation();
                    if (!path) return;
                    
                    var scriptName = path.replace(/^\/+/, '');
                    var logWin = window.open('/logging.htm?done=Close', 'qf_log_window', 'width=800,height=600,resizable=yes,scrollbars=yes');
                    var fetchUrl = '/plugins/quick.favorites/log_api.php?script=' + encodeURIComponent(scriptName);
                    
                    fetch(fetchUrl)
                        .then(function(res) { return res.text(); })
                        .then(function(logData) {
                            var checkReady = setInterval(function() {
                                if (logWin && logWin.document && logWin.document.readyState === 'complete') {
                                    clearInterval(checkReady);
                                    var contentDiv = logWin.document.createElement('div');
                                    contentDiv.style.whiteSpace = 'pre-wrap';
                                    contentDiv.style.fontFamily = 'monospace';
                                    contentDiv.style.padding = '10px';
                                    contentDiv.innerHTML = logData; 
                                    logWin.document.body.insertBefore(contentDiv, logWin.document.body.firstChild);
                                    logWin.scrollTo(0, logWin.document.body.scrollHeight);
                                }
                            }, 50);
                        });
                    customMenu.style.display = 'none';
                }
            }
        }
    }
}, true);
</script>
<!-- QUICK_FAVORITES_INJECT_END -->
EOF2

# 4. Safely inject into template.php right before </body>
if grep -q '</body>' "$TEMPLATE"; then
  sed -i "/<\/body>/e cat '$TMPFILE'" "$TEMPLATE"
else
  cat "$TMPFILE" >> "$TEMPLATE"
fi
rm -f "$TMPFILE"

echo "----------------------------------------------------"
echo " Quick Favorites v&version; installed & injected successfully."
echo "----------------------------------------------------"
]]>
</INLINE>
</FILE>

<!-- AUTOMATED CLEANUP ON PLUGIN REMOVAL -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="quick.favorites"
TEMPLATE="/usr/local/emhttp/plugins/dynamix/template.php"
MARK_START="<!-- QUICK_FAVORITES_INJECT_START -->"
MARK_END="<!-- QUICK_FAVORITES_INJECT_END -->"

# Remove the injection block from template.php
sed -i "/$MARK_START/,/$MARK_END/d" "$TEMPLATE"
rm -rf "/usr/local/emhttp/plugins/$NAME"

echo "Quick Favorites runtime files and template patch removed."
]]>
</INLINE>
</FILE>
</PLUGIN>