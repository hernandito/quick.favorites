<?php
$cfg_dir = "/boot/config/plugins/quick.favorites";
$json_file = "$cfg_dir/favorites.json";
$css_file = "$cfg_dir/custom.css";
$notes_file = "$cfg_dir/user_notes.txt";

if (!is_dir($cfg_dir)) {
    mkdir($cfg_dir, 0755, true);
}

// 1. AJAX Listener: Unraid Core-Aware Auto-Scanner
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'get_native_icon') {
    $path = trim($_POST['path'] ?? '');
    $icon = 'fa-star'; 
    
    $core_icons = [
        '/Dashboard' => 'fa-tachometer',
        '/Main' => 'fa-server',
        '/Shares' => 'fa-folder-open',
        '/Users' => 'fa-user',
        '/Settings' => 'fa-cogs',
        '/Settings/Docker' => 'fa-docker',
        '/Docker' => 'fa-docker',
        '/Plugins' => 'fa-plug',
        '/Apps' => 'fa-cubes',
        '/Settings/NetworkSettings' => 'fa-sitemap',
        '/Tools' => 'fa-wrench',
        '/VMs' => 'fa-desktop',
        '/SystemInformation' => 'fa-info-circle',
        '/Tools/Syslog' => 'fa-file-text-o'
    ];

    if (array_key_exists($path, $core_icons)) {
        $icon = $core_icons[$path];
    } elseif (!empty($path)) {
        $basename = strtolower(basename($path));
        $files = glob("/usr/local/emhttp/plugins/*/*.page");
        
        foreach ($files as $file) {
            $page_name = strtolower(basename($file, '.page'));
            if ($page_name === $basename) {
                $content = file_get_contents($file);
                if (preg_match('/Icon="([^"]+)"/i', $content, $matches)) {
                    $found = trim($matches[1]);
                    if (strpos($found, '/') !== false) {
                        $icon = $found;
                    } elseif (strpos($found, '.') !== false) {
                        $plugin_dir = basename(dirname($file));
                        $icon = "/plugins/" . $plugin_dir . "/images/" . $found;
                    } else {
                        $icon = (strpos(strtolower($found), 'fa-') === 0) ? strtolower($found) : "fa-" . strtolower($found);
                    }
                    break;
                }
            }
        }
    }
    echo $icon;
    exit;
}

// 1.5 AJAX Listener: Safe Log Reader
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'get_script_log') {
    while (ob_get_level()) { ob_end_clean(); }
    
    $path = trim($_POST['path'] ?? '');
    $path = preg_replace('/[^a-zA-Z0-9 \-_]/', '', $path);
    $logFile = "/tmp/user.scripts/tmpScripts/" . $path . "/log.txt";
    
    if (file_exists($logFile)) {
        echo file_get_contents($logFile);
    } else {
        echo "<span style='color:#ff4444; font-weight:bold;'>Log file not found. The script has not been run in the background yet, or the log was cleared.</span>";
    }
    exit;
}

// 2. Handle Save
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['save_favs'])) {
    $new_favs = [];
    $categories = $_POST['category'] ?? [];
    $labels = $_POST['label'] ?? [];
    $paths = $_POST['path'] ?? [];
    $icons = $_POST['icon'] ?? [];
    $actions = $_POST['action_type'] ?? [];
    
    for ($i = 0; $i < count($paths); $i++) {
        $cat = trim($categories[$i]);
        $l = trim($labels[$i]);
        $p = trim($paths[$i]);
        $ic = trim($icons[$i]);
        $act = trim($actions[$i]);
        
        if ($ic === '' || strpos($ic, 'spin') !== false) $ic = 'fa-star';
        if ($cat === '') $cat = 'Uncategorized';
        
		if ($p !== '' && $l !== '') {
            $new_favs[] = [
                'path' => $p,
                'category' => $cat,
                'label' => $l,
                'icon' => $ic,
                'action' => $act
            ];
        }
    }
    
    file_put_contents($json_file, json_encode($new_favs, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    
    $custom_css = $_POST['custom_css'] ?? '';
    file_put_contents($css_file, $custom_css);

    $user_notes = $_POST['user_notes'] ?? '';
    file_put_contents($notes_file, $user_notes);
	
	$appearance_data = [
        'menu_title' => $_POST['menu_title'] ?? 'Quick Favorites',
        'icon_size' => $_POST['icon_size'] ?? '42',
        'grid_columns' => $_POST['grid_columns'] ?? '5',
        'menu_width' => $_POST['menu_width'] ?? '480',
        'show_header' => $_POST['show_header'] ?? 'no',
        'hover_color' => $_POST['hover_color'] ?? '#333333',
        'bg_color' => $_POST['bg_color'] ?? '#000000',
        'header_color' => $_POST['header_color'] ?? '#FFCA28',
        'header_line' => $_POST['header_line'] ?? '#333333',
        'section_title_color' => $_POST['section_title_color'] ?? '#FFCA28',
        'section_border_color' => $_POST['section_border_color'] ?? '#554000',
        'icon_color' => $_POST['icon_color'] ?? '#FFCA28',
        'label_color' => $_POST['label_color'] ?? '#CCCCCC'
    ];
	
    file_put_contents("$cfg_dir/appearance.json", json_encode($appearance_data, JSON_PRETTY_PRINT));

    echo "<script>$(function() { swal({title:'Saved', text:'Settings updated!', type:'success', confirmButtonText:'Ok'}, function(){ window.location.href = window.location.pathname; }); });</script>";
}

// 3. Load Existing Configuration
$favs = [];
if (file_exists($json_file)) {
    $raw = json_decode(file_get_contents($json_file), true);
    if (is_array($raw)) {
        foreach ($raw as $key => $data) {
            if (is_string($data)) {
                $data = ['category' => 'General', 'label' => $data, 'icon' => 'fa-star', 'action' => '_self', 'path' => $key];
            } else {
                if (!isset($data['path'])) {
                    $data['path'] = $key;
                }
            }
            $favs[] = $data;
        }
    }
}

$appearance_file = "$cfg_dir/appearance.json";
$defaults = [
    'menu_title' => 'Quick Favorites',
    'icon_size' => '32',
    'bg_color' => '#1c1c1c',
    'header_color' => '#ffca28',
    'header_line' => '#333333',
    'section_title_color' => '#888888',
    'text_color' => '#e0e0e0',
    'grid_columns' => '4',
    'menu_width' => '480',
    'hover_color' => '#333333',
    'show_header' => 'yes'
];

$style = file_exists($appearance_file) ? array_merge($defaults, json_decode(file_get_contents($appearance_file), true)) : $defaults;
$saved_css = file_exists($css_file) ? file_get_contents($css_file) : '';
$saved_notes = file_exists($notes_file) ? file_get_contents($notes_file) : '';
?>

<style>
    .qf-fa-link { color: #0132f2; text-decoration: none; font-weight: bold; }
    .qf-fa-link:hover { text-decoration: underline; }
    .qf-input { width: 100%; box-sizing: border-box; margin: 0; height: 30px; background: transparent; color: inherit; border: none; border-bottom: 1px solid rgba(128, 128, 128, 0.4); outline: none; }
    .qf-table { width: 100%; border-collapse: separate; border-spacing: 0 6px; }
    .qf-table thead tr th { text-align: left; padding: 4px 10px; background-color: rgba(128, 128, 128, 0.35); border-radius: 0px; }
    .qf-row { background-color: rgba(128, 128, 128, 0.08); border: 1px solid rgba(128, 128, 128, 0.2); border-radius: 8px; }
    .qf-table tbody tr td { padding: 5px 10px; vertical-align: middle; }
    .drag-handle { cursor: grab; color: #888; font-size: 16px; text-align: center; width: 20px; }
    .drag-handle:active { cursor: grabbing; }
    .preview-wrapper { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; flex-shrink: 0; }
    .preview-wrapper i { color: #777; font-size: 32px; }
    .preview-wrapper img { max-width: 32px; max-height: 32px; }
    .qf-btn-remove { width: 30px; height: 30px; padding: 0; color: #ff4444; text-align: center; cursor: pointer; border: none; background: none; }
    .qf-guide-block { border-radius: 8px; padding: 20px; box-sizing: border-box; border: 1px solid #b5b5b5; border-left: 8px solid #a8a8a9; padding-top: 15px; }
    .qf-notes-area { width: 100%; box-sizing: border-box; min-height: 250px; flex-grow: 1; border: 1px solid rgba(128, 128, 128, 0.4); border-radius: 8px; padding: 10px; background: transparent; color: inherit; font-family: monospace; resize: vertical; }
    code { font-family: monospace; background-color: #f4f4f4; padding: 2px 6px; border-radius: 4px; color: #c7254e; }
</style>

<style>
    <?= $saved_css ?>
</style>

<div style="width: 95%; margin: 0 auto; padding-bottom: 50px;">
    <h2 style="margin-bottom: 6px;">Manage Quick Favorites</h2>
    
    <form method="POST" action="/Settings/QuickFavorites">
        <table class="qf-table">
			<thead>
				<tr>
					<th style="width: 30px;"></th> 
					<th style="max-width: 140px; width: 10%;">Category</th>
					<th style="max-width: 140px; width: 10%;">Label</th>
					<th style="width: 30%;">Path / URL</th>
					<th style="width: 35%;">Icon Path / FA Class</th>
					<th style="width: 15%;">Action</th>
					<th style="width: 40px; text-align:center;">Delete</th>
				</tr>
			</thead>
			<tbody id="fav-table-body">
                <?php foreach ($favs as $index => $data): ?>
                <tr class="qf-row">
                    <td class="drag-handle" title="Drag to reorder"><i class="fa fa-bars"></i></td>
                    <td style="max-width: 140px;"><input style="font-weight:bold;" type="text" name="category[]" value="<?= htmlspecialchars($data['category']) ?>" required class="qf-input"></td>
                    <td style="max-width: 140px;"><input style="font-weight:bold;" type="text" name="label[]" value="<?= htmlspecialchars($data['label']) ?>" required class="qf-input"></td>
                    <td><input type="text" name="path[]" value="<?= htmlspecialchars($data['path']) ?>" required class="qf-input path-input"></td>
					<td>
						<div style="display:flex; align-items:center; gap:8px;">
						<span class="preview-wrapper">
                            <?php if (strpos($data['icon'], '/') !== false || strpos($data['icon'], '.') !== false): ?>
                                <img src="<?= htmlspecialchars($data['icon']) ?>" style="width:28px; height:28px;">
                            <?php elseif (preg_match('/^[a-zA-Z0-9\-]+$/', $data['icon'])): ?>
                                <?php $fa = (strpos($data['icon'], 'fa-') === 0) ? $data['icon'] : 'fa-' . $data['icon']; ?>
                                <i class="fa <?= htmlspecialchars($fa) ?>" style="width:28px; text-align:center;"></i>
                            <?php else: ?>
                                <span style="font-family: 'Noto Color Emoji', sans-serif; font-size: 28px; line-height: 28px; display: inline-block; width: 28px; text-align: center;"><?= htmlspecialchars($data['icon']) ?></span>
                            <?php endif; ?>
                        </span>
							<input type="text" name="icon[]" value="<?= htmlspecialchars($data['icon']) ?>" required class="qf-input" oninput="updatePreview(this)">
						</div>
					</td>
					<td>
						<select name="action_type[]" class="qf-input">
                            <option value="_self" <?= (isset($data['action']) && $data['action'] == '_self') ? 'selected' : '' ?>>Same Tab</option>
                            <option value="_blank" <?= (isset($data['action']) && $data['action'] == '_blank') ? 'selected' : '' ?>>New Tab</option>
                            <option value="script_modal" <?= (isset($data['action']) && $data['action'] == 'script_modal') ? 'selected' : '' ?>>Run Script (Console)</option>
                            <option value="script_background" <?= (isset($data['action']) && $data['action'] == 'script_background') ? 'selected' : '' ?>>Run Script (Background)</option>
                            <option value="script_log" <?= (isset($data['action']) && $data['action'] == 'script_log') ? 'selected' : '' ?>>User Script Log</option>
                        </select>
					</td>
					<td class="qf-row-right-end" style="text-align:center;">
						<button type="button" class="qf-btn-remove" onclick="$(this).closest('tr').remove();"><i class="fa fa-times"></i></button>
					</td>
				</tr>
				<?php endforeach; ?>
			</tbody>
        </table>
        
		<div style="margin-top: 15px; display: flex; gap: 15px; align-items: center;">
            <input type="button" value="Add Row" onclick="addRow()" style="padding: 8px 15px; cursor: pointer; border-radius: 4px;">
            <input type="button" value="Cancel" onclick="window.location.href='/Settings'" style="padding: 8px 15px; cursor: pointer; border-radius: 4px;">
            <input type="submit" name="save_favs" value="Save Settings" style="background-color: #ffca28; color: #111; font-weight: bold; padding: 8px 20px; border-radius: 4px; cursor: pointer; border: none;">
        </div>
    </form>
</div>

<script>
$(function() {
    if (typeof $.fn.sortable !== 'undefined') {
        $("#fav-table-body").sortable({
            handle: '.drag-handle',
            cursor: 'grabbing',
            axis: 'y',
            opacity: 0.8
        });
    }
});

function updatePreview(inputElement) {
    var val = $(inputElement).val().trim();
    var wrapper = $(inputElement).siblings('.preview-wrapper');
    
    if (val.includes('/') || val.includes('.')) {
        wrapper.html('<img src="' + val + '" style="width:28px; height:28px;">');
    } else if (/^[a-zA-Z0-9\-]+$/.test(val)) {
        if (!val.startsWith('fa-') && val !== '') val = 'fa-' + val;
        wrapper.html('<i class="fa ' + val + '" style="width:28px; text-align:center;"></i>');
    } else {
        wrapper.html('<span style="font-family: \'Noto Color Emoji\', sans-serif; font-size: 28px; line-height: 28px; display: inline-block; width: 28px; text-align: center;">' + val + '</span>');
    }
}

function addRow() {
    var newRow = `<tr class="qf-row">
        <td class="drag-handle" title="Drag to reorder"><i class="fa fa-bars"></i></td>
        <td style="max-width: 140px;"><input type="text" name="category[]" placeholder="Category" required class="qf-input"></td>
        <td style="max-width: 140px;"><input type="text" name="label[]" placeholder="Label" required class="qf-input"></td>
        <td><input type="text" name="path[]" placeholder="Folder or URL" required class="qf-input path-input"></td>
        <td>
            <div style="display:flex; align-items:center; gap:8px;">
                <span class="preview-wrapper"><i class="fa fa-star"></i></span>
                <input type="text" name="icon[]" placeholder="fa-star" required class="qf-input" oninput="updatePreview(this)">
            </div>
        </td>
        <td>
			<select name="action_type[]" class="qf-input">
                <option value="_self">Same Tab</option>
                <option value="_blank">New Tab</option>
                <option value="script_modal">Run Script (Console)</option>
                <option value="script_background">Run Background</option>
                <option value="script_log">User Script Log</option>
            </select>
        </td>
        <td class="qf-row-right-end" style="text-align:center;">
            <button type="button" class="qf-btn-remove" onclick="$(this).closest('tr').remove();"><i class="fa fa-times"></i></button>
        </td>
    </tr>`;
    $('#fav-table-body').append(newRow);
}
</script>