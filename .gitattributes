# Auto detect text files and perform LF normalization
* text=auto

# Hooks and shell scripts MUST keep LF endings.
# On Windows, a CRLF shebang line ("#!/bin/sh\r") makes Git Bash fail with
# "bad interpreter: no such file or directory" and the hook silently never runs.
.githooks/**  text eol=lf
*.sh          text eol=lf

# Binary - never touch these
*.png  binary
*.jpg  binary
*.gz   binary
*.txz  binary
